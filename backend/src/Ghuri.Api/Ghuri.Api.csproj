<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Not a secret itself - just the NAME of the folder holding this
         project's secrets, OUTSIDE the repo:
         %APPDATA%\Microsoft\UserSecrets\<this id>\secrets.json
         Read only in Development. Holds Jwt:SigningKey (see README). -->
    <UserSecretsId>96022def-04b3-4188-8e01-78da1ba6d326</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Structured logging. Api is where logs get their DESTINATION
         (console, file...); Application only writes ILogger calls. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Design-time only: gives the "dotnet ef" CLI tool something to talk to.
         Api is the "startup project" for EF Core commands even though the
         AppDbContext class itself lives in Ghuri.Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ghuri.Infrastructure\Ghuri.Infrastructure.csproj" />
    <ProjectReference Include="..\Ghuri.Application\Ghuri.Application.csproj" />
  </ItemGroup>

</Project>
