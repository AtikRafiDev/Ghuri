# Try the API by hand. Works with Visual Studio's .http editor and the
# VS Code "REST Client" extension: click "Send Request" above each request.
# Start the API first:  cd backend  ->  dotnet run --project src/Ghuri.Api

@host = http://localhost:5176
@auth = {{host}}/api/v1/auth

### Is the API up, and can it reach the database?
GET {{host}}/health/ready

###############################################################################
# FIRST LOGIN AS SUPER ADMIN (run "dotnet run --project src/Ghuri.Api -- seed"
# once before this). The seeded account has no password - set one via the
# normal "forgot password" flow.
###############################################################################

### 1. Ask for a reset link. Always 204 (it never reveals if the email exists).
#       Then look in the API's console for "DEVELOPMENT EMAIL" and copy the
#       long value after "token=" (up to, not including, the closing quote).
POST {{auth}}/password/forgot
Content-Type: application/json

{ "email": "admin@ghuri.local" }

### 2. Paste the token here, choose your password (8+ characters), send. 204 = done.
@resetToken = PASTE-THE-TOKEN-HERE
@myPassword = choose-a-good-password

POST {{auth}}/password/reset
Content-Type: application/json

{ "email": "admin@ghuri.local", "token": "{{resetToken}}", "newPassword": "{{myPassword}}" }

### 3. Log in. 200 = { accessToken, expiresAtUtc } + a Set-Cookie header (the refresh token).
# @name login
POST {{auth}}/login
Content-Type: application/json

{ "phoneOrEmail": "admin@ghuri.local", "password": "{{myPassword}}" }

### 4. Who am I? Uses the access token from step 3. Expect roles: ["SuperAdmin"].
GET {{auth}}/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 5. Refresh: trade the cookie for a new access token + a new cookie.
# A browser sends the cookie by itself; this tool can't (the cookie is
# "Secure" and this is plain http), so it's copied from step 3 by hand.
# Each refresh token works ONCE - to refresh again, log in again (step 3).
POST {{auth}}/refresh
Cookie: {{login.response.headers.Set-Cookie}}

### 6. Log out (ends the session from step 3). Always 204.
POST {{auth}}/logout
Cookie: {{login.response.headers.Set-Cookie}}

###############################################################################
# FILE UPLOAD (staff only - log in as Super Admin with step 3 above first)
###############################################################################

### Upload an image. Put any JPEG/PNG next to this file and name it test.jpg
# (or change the path). 201 = { id, url, width, height }; open
# {{host}}{url} in a browser to see the stored WebP.
POST {{host}}/api/v1/files
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: multipart/form-data; boundary=GhuriBoundary

--GhuriBoundary
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./test.jpg
--GhuriBoundary--

###############################################################################
# CATALOGUE - public (no login)
###############################################################################

### All destinations (national + international)
GET {{host}}/api/v1/destinations

### Only inside Bangladesh / only abroad / only home-page featured
GET {{host}}/api/v1/destinations?scope=national
###
GET {{host}}/api/v1/destinations?scope=international&featured=true

### Categories, countries
GET {{host}}/api/v1/categories
###
GET {{host}}/api/v1/countries

###############################################################################
# CATALOGUE - admin (log in as Super Admin with step 3 above first)
###############################################################################

### Destinations table: search + filter + paging
GET {{host}}/api/v1/admin/destinations?search=bazar&scope=national&page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.accessToken}}

### Add a destination. countryId = Bangladesh's "id" from GET /api/v1/countries
# (the database assigns country ids, so look yours up once and paste it below).
# slug empty = made from the name.
@bangladeshId = PASTE-BANGLADESH-ID
# @name newDestination
POST {{host}}/api/v1/admin/destinations
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "countryId": {{bangladeshId}}, "name": "Mohastangarh", "slug": "", "summary": "The oldest city of Bengal.", "imageFileIds": [],
  "isFeatured": false, "sortOrder": 500, "seoTitle": null, "seoDescription": null }

### Edit it (the whole form is sent every time)
PUT {{host}}/api/v1/admin/destinations/{{newDestination.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "countryId": {{bangladeshId}}, "name": "Mahasthangarh", "slug": "mahasthangarh", "summary": "Ancient Pundranagar, near Bogura.",
  "imageFileIds": [], "isFeatured": true, "sortOrder": 500, "seoTitle": null, "seoDescription": null }

### Delete it (soft delete; 409 if packages use it)
DELETE {{host}}/api/v1/admin/destinations/{{newDestination.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Categories table
GET {{host}}/api/v1/admin/categories
Authorization: Bearer {{login.response.body.$.accessToken}}

### Add a category (icon = a lucide-react icon name)
POST {{host}}/api/v1/admin/categories
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Photography Tour", "slug": null, "icon": "camera", "sortOrder": 160 }

###############################################################################
# TOUR PACKAGES - admin (log in as Super Admin with step 3 above first)
# Enums are numbers: pricingMode 1 = Fixed departures, 2 = Flexible stay;
# status 1 = Draft, 2 = Published, 3 = Archived; tourType 1 = Group,
# 2 = Private, 3 = Custom.
###############################################################################

### Pick a destination and a category to use below (the first of each list).
# @name anyDestination
GET {{host}}/api/v1/destinations
###
# @name anyCategory
GET {{host}}/api/v1/categories

### Add a FIXED-departure package (3 days / 2 nights). 201 = { id }.
# Send it twice to see 409 package_slug_taken.
# @name fixedPackage
POST {{host}}/api/v1/admin/packages
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "destinationId": "{{anyDestination.response.body.$[0].id}}", "title": "Beach Escape 3 Days", "slug": null,
  "summary": "Three days by the sea with hotel and breakfast.", "description": null, "tourType": 1,
  "categoryIds": ["{{anyCategory.response.body.$[0].id}}"], "inclusions": ["Hotel stay", "Breakfast"], "exclusions": ["Air fare"],
  "termsAndPolicy": null, "minAge": null, "isFeatured": false, "seoTitle": null, "seoDescription": null,
  "pricingMode": 1, "durationDays": 3, "durationNights": 2,
  "minNights": null, "maxNights": null, "basePrice": null, "extraNightPrice": null, "minLeadDays": null }

### Add a FLEXIBLE-stay package: 2-7 nights, ৳8,000 per adult for 2 nights,
# ৳3,000 per extra night, book at least 3 days ahead. Duration is worked out (3 days / 2 nights).
# @name flexiblePackage
POST {{host}}/api/v1/admin/packages
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "destinationId": "{{anyDestination.response.body.$[0].id}}", "title": "Sea Pearl Flexible Stay", "slug": null,
  "summary": "Pick your dates and how many nights.", "description": null, "tourType": 2,
  "categoryIds": [], "inclusions": ["Sea-view room"], "exclusions": [],
  "termsAndPolicy": "Subject to hotel confirmation within 24 hours.", "minAge": null, "isFeatured": true,
  "seoTitle": null, "seoDescription": null,
  "pricingMode": 2, "durationDays": null, "durationNights": null,
  "minNights": 2, "maxNights": 7, "basePrice": 8000, "extraNightPrice": 3000, "minLeadDays": 3 }

### Flexible WITHOUT prices: 400 with errors on basePrice and extraNightPrice.
POST {{host}}/api/v1/admin/packages
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "destinationId": "{{anyDestination.response.body.$[0].id}}", "title": "Broken Flexible", "summary": "x", "tourType": 1,
  "pricingMode": 2, "minNights": 2, "maxNights": 7, "minLeadDays": 0 }

### Packages table (both new packages, newest first, PKG codes, "from" price)
GET {{host}}/api/v1/admin/packages?page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.accessToken}}

### Only flexible packages / search by code
GET {{host}}/api/v1/admin/packages?pricingMode=2
Authorization: Bearer {{login.response.body.$.accessToken}}
###
GET {{host}}/api/v1/admin/packages?search=PKG
Authorization: Bearer {{login.response.body.$.accessToken}}

### One package - look at "publishProblems": photo + itinerary still missing.
GET {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Try to publish now: 409 package_not_publishable, listing both problems.
POST {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/publish
Authorization: Bearer {{login.response.body.$.accessToken}}

### Add the photos: ids from the FILE UPLOAD request above (first = cover).
@photoId = PASTE-AN-UPLOADED-FILE-ID
PUT {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/images
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "imageFileIds": ["{{photoId}}"] }

### Add the itinerary - 3 days, matching the 3-day duration.
PUT {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/itinerary
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "days": [
    { "title": "Arrive", "description": "Check in, evening on the beach.", "meals": "D", "accommodation": "Sea Pearl" },
    { "title": "Inani & Himchari", "description": "Day trip along Marine Drive.", "meals": "B,D", "accommodation": "Sea Pearl" },
    { "title": "Leave", "description": "Breakfast, check out.", "meals": "B", "accommodation": null } ] }

### Publish again: 204 this time.
POST {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/publish
Authorization: Bearer {{login.response.body.$.accessToken}}

### Switch the PUBLISHED fixed package to flexible: 409 package_pricing_mode_locked.
PUT {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "destinationId": "{{anyDestination.response.body.$[0].id}}", "title": "Beach Escape 3 Days", "summary": "Three days by the sea.",
  "tourType": 1, "pricingMode": 2, "minNights": 2, "maxNights": 5, "basePrice": 9000, "extraNightPrice": 2500, "minLeadDays": 2 }

### Remove every photo from the PUBLISHED package: 422 package_must_stay_publishable.
PUT {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/images
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "imageFileIds": [] }

### Archive it (204), then it can be changed freely and published again.
POST {{host}}/api/v1/admin/packages/{{fixedPackage.response.body.$.id}}/archive
Authorization: Bearer {{login.response.body.$.accessToken}}

###############################################################################
# CUSTOMERS
###############################################################################

### Register a customer - logged in immediately (201 + access token + cookie).
POST {{auth}}/register
Content-Type: application/json

{ "fullName": "Rahim Uddin", "phone": "01711000000", "email": "rahim@example.com", "password": "rahim-password" }
