<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ghuri.Domain\Ghuri.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <!-- A source generator is a compile-time tool, not a runtime library:
         PrivateAssets=all keeps it from leaking into projects that
         reference Application (Infrastructure, Api). It lives HERE because
         the handlers will live here - it generates dispatch code for the
         project it's installed in. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Only for async LINQ in QUERY handlers (blueprint section 3.1).
         Command handlers must never use it - they go through repositories. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Fills AuthOptions from the "Auth" section and checks it at startup. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Handlers are "internal" (nothing outside Application should call
         them directly - everyone goes through ISender). This lets ONLY the
         test project see them, so they can be unit-tested. -->
    <InternalsVisibleTo Include="Ghuri.Application.Tests" />
  </ItemGroup>
</Project>
