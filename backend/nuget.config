<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- <clear /> throws away the feeds configured globally on this machine
       (your private "Rasdan" Azure DevOps feed and the VS offline folder) so
       this project builds the same way on your PC, on a teammate's PC and on
       the CI server. It also removes the NU1507 warning that central package
       management raises when several feeds are active. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping: every package must come from nuget.org and nowhere else.
       This blocks "dependency confusion", where someone publishes a package
       with the same name as an internal one to trick your build into taking
       theirs. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
