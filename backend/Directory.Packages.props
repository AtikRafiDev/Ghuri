<Project>

  <!-- Central Package Management.
       With this turned on, a .csproj says WHICH package it needs and this file
       says WHICH VERSION. One place to upgrade; no chance of two projects
       quietly using two different versions of the same library. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Checks the "Authorization: Bearer <JWT>" header on every request:
         signature, issuer, audience, expiry. Microsoft's official one. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Persistence (EF Core)">
    <!-- Lets Infrastructure talk to SQL Server / LocalDB. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Core EF only (no SQL Server provider) - for Application's query
         handlers to call ToListAsync/FirstOrDefaultAsync on IReadDbContext.
         The one EF reference the blueprint allows in Application (sec 3.1). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- Health check that asks "can AppDbContext actually reach the database?" -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <!-- Powers the "dotnet ef" command-line tool (migrations add/database update).
         Only referenced by the STARTUP project (Api) - it is a design-time-only
         tool, never needed while the app is actually running. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Application (CQRS + validation)">
    <!-- martinothamar/Mediator (MIT) - NOT MediatR, which went commercial in
         2025 (blueprint section 1). Abstractions = the interfaces
         (ICommand, IQuery, IPipelineBehavior...); SourceGenerator = writes
         the dispatch code at compile time instead of using reflection. -->
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- Only the ILogger<T> interface - no actual logging implementation.
         Application writes log calls; Api decides where they go (Serilog). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Security (Infrastructure)">
    <!-- Only the password hasher from ASP.NET Core Identity (PBKDF2,
         blueprint section 8) - NOT Identity's EF tables (AspNetUsers...).
         We keep our own iam.Users table and use just this one class. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <!-- Creates the signed JWT access tokens. Microsoft's current JWT
         library (the older System.IdentityModel.Tokens.Jwt is legacy). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- Lets a settings class be filled from appsettings.json and checked
         at startup (BindConfiguration + ValidateOnStart). -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Images (Infrastructure)">
    <!-- Decodes, rotates, resizes and re-encodes uploads to WebP (MIT licence;
         ImageSharp was avoided for its revenue-based licence). Brings the
         Windows/Mac native parts; a Linux server also needs
         SkiaSharp.NativeAssets.Linux.NoDependencies (Day 7). -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <!-- Boots the real Api in memory (no port, no browser) so a test can
         send it real HTTP requests - Microsoft's official way to test an
         ASP.NET Core app end to end. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

</Project>
