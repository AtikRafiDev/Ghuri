<Project>

  <!-- Central Package Management.
       With this turned on, a .csproj says WHICH package it needs and this file
       says WHICH VERSION. One place to upgrade; no chance of two projects
       quietly using two different versions of the same library. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Persistence (EF Core)">
    <!-- Lets Infrastructure talk to SQL Server / LocalDB. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Powers the "dotnet ef" command-line tool (migrations add/database update).
         Only referenced by the STARTUP project (Api) - it is a design-time-only
         tool, never needed while the app is actually running. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

</Project>
